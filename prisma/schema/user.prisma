model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  password     String?
  googleId     String?      @unique
  authProvider AuthProvider @default(CREDENTIAL)
  role         Role         @default(USER)
  avatarUrl    String?
  phone        String?
  bio          String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  properties Property[] @relation("AgentProperties")
  reviews    Review[]
  favorites  Favorite[]
  inquiries  Inquiry[]
}
