model Inquiry {
    id         String   @id @default(cuid())
    name       String
    email      String
    message    String
    userId     String?
    user       User?    @relation(fields: [userId], references: [id])
    propertyId String
    property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
    createdAt  DateTime @default(now())
}
